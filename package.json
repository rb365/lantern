{
  "name": "lantern",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Lantern — private, offline translation that runs in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "node build-info.cjs && tsc --noEmit && vite build",
    "build:gh": "node build-info.cjs && tsc --noEmit && vite build --base=/lantern/",
    "version": "node build-info.cjs --skip-bump",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@mlc-ai/web-llm": "^0.2.80",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
